ILANG
TYPE config
PROJECT vps-deals-promo-radar
LANG zh

::STATE{@SITE, brand:vps-deals, niche:VPS主机, domain:vpsdealswire.com, locale:en-US, currency:USD, repo_name:vps-deals-promo-radar}

